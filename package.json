{
  "name": "tasks",
  "version": "1.0.0",
  "description": "Gestionnaire de tâches par projet avec journal quotidien",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:e2e": "vite build && playwright test",
    "db:migrate": "node --disable-warning=ExperimentalWarning server/migrate.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "lucide-react": "1.47.0",
    "marked": "18.0.13",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  }
}
