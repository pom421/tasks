{
  "name": "tasks",
  "version": "1.0.0",
  "description": "Gestionnaire de tâches par projet avec journal quotidien",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "dev": "vite",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts && TASKS_DB=data/demo.db vite",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:e2e": "vite build && playwright test",
    "db:migrate": "node --disable-warning=ExperimentalWarning server/migrate.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.71.0",
    "marked": "18.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  }
}
